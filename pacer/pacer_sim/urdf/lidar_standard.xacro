<?xml version="1.0"?>
<!--
Sostituto del lidar reale di jo_description (urdf/velodyne.xacro), che usa
il plugin RGL (RobotecAI, GPU lidar) — una dipendenza extra non installata
in questa immagine, non un plugin gz-sim standard. Qui stesso punto di
mount/stessa geometria (base2lidar, offset b2l_*), ma sensore
"gpu_lidar" standard di gz-sim: nessuna dipendenza aggiuntiva, sufficiente
per alimentare il local/global costmap di Nav2 (jo_navigation/config/
nav2_local.yaml si aspetta una PointCloud2 su /velodyne_points — stesso
nome di topic della RGL reale, così il file nav2_local.yaml resta
invariato, vedi config/nav2_pacer_sim.yaml).
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:property name="b2l_x" value="0.03" />
  <xacro:property name="b2l_y" value="0.0286" />
  <xacro:property name="b2l_z" value="0.564" />
  <xacro:property name="lidar_mass" value="0.125" />
  <xacro:property name="lidar_len_rad" value="0.07" />
  <xacro:property name="lidar_len_h" value="0.072" />

  <xacro:macro name="lidar_sensor_standard" params="">
    <joint name="base2lidar" type="fixed">
      <parent link="base_link"/>
      <child link="velodyne"/>
      <origin xyz="${b2l_x} ${b2l_y} ${b2l_z + lidar_len_h/2}" rpy="0 0 0"/>
    </joint>

    <link name="velodyne">
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${lidar_len_rad}" length="${lidar_len_h}"/>
        </geometry>
      </collision>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${lidar_len_rad}" length="${lidar_len_h}"/>
        </geometry>
        <material name="blue"/>
      </visual>
      <xacro:inertial_cylinder mass="${lidar_mass}" radius="${lidar_len_rad}" length="${lidar_len_h}">
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </xacro:inertial_cylinder>
    </link>

    <gazebo reference="velodyne">
      <sensor name="velodyne_gpu_lidar" type="gpu_lidar">
        <topic>velodyne_points</topic>
        <update_rate>10</update_rate>
        <gz_frame_id>velodyne</gz_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>640</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
            <vertical>
              <samples>16</samples>
              <resolution>1</resolution>
              <min_angle>-0.2618</min_angle>
              <max_angle>0.2618</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.1</min>
            <max>30.0</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
        <always_on>1</always_on>
        <visualize>true</visualize>
      </sensor>
    </gazebo>
  </xacro:macro>

  <xacro:lidar_sensor_standard/>

</robot>
