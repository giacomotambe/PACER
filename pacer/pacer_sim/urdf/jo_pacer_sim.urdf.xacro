<?xml version="1.0"?>
<!--
Robot Jo per il test pacer_sim: stesso xacro di
jo_description/urdf/jo_main.urdf.xacro, con QUESTE differenze:

1. Velodyne reale (RGL, dipendenza GPU extra non installata qui) sostituito
   da urdf/lidar_standard.xacro (gz-sim gpu_lidar standard), stesso punto
   di mount. Telaio/cingoli/IMU/camere restano quelli reali di
   jo_description, inclusi qui via $(find jo_description) — jo_description
   NON viene modificato.

2. Propulsione: NON usa gz-sim-tracked-vehicle-system (il plugin dei
   cingoli reali). Diagnosticato a fondo (log del plugin, test diretto su
   Ignition Transport bypassando ROS, controllo del riferimento
   ~/jo_sim_giacomo — stesso problema li', mai risolto): il robot si
   iscrive correttamente a /model/jo/cmd_vel ma non si muove MAI, nemmeno
   con friction/contact espliciti sulla collision dei cingoli, perche'
   TrackedVehicle sostituisce la gestione fisica di quelle collision con
   un proprio sistema di "contact surface customization" (si vede nel log:
   "Enabling contact surface customization for collision [...]") che
   sembra non produrre trazione reale in questa versione di gz-sim
   (Fortress / gz-sim 6, non Harmonic). Non e' un problema risolvibile con
   i pochi parametri SDF documentati del plugin.

   Al posto dei cingoli: gz-sim-diff-drive-system standard (maturo, ben
   documentato, usa giunti REVOLUTE normali) su 2 ruote motrici centrali
   + 2 supporti passivi a sfera (pattern "caster via sfera a bassissimo
   attrito", il piu' diffuso/testato per DiffDrive — la prima versione
   con 4 ruote motrici, 2 giunti per lato, andava dritto ma NON girava
   mai, nemmeno impostando i limiti di velocita' angolare mancanti;
   configurazione multi-giunto-per-lato probabilmente meno matura in
   questa versione del plugin, non diagnosticabile oltre senza
   introspezione diretta dei giunti — mai riuscita, i giunti "continuous"
   non pubblicano TF senza un joint_states che qui non c'e'). Tutti i
   giunti dei cingoli reali restano <fixed> (nessuna rotazione possibile,
   servono solo da corpo statico che segue la carrozzeria per l'aspetto
   visivo), quindi non c'e' nulla su cui agganciare un plugin ruota
   diretto. Ruote/caster staccati dalla geometria visiva dei cingoli,
   dimensionati per reggere il peso ed entrare in contatto col terreno
   indipendentemente da dove si trovano esattamente i cingoli.

Odometria/TF: dal plugin standard gz-sim-odometry-publisher-system, che
calcola odom/TF dalla posa reale del modello nel mondo simulato (ground
truth) — stessa scelta fatta quando si usava ancora TrackedVehicle (la cui
odometria interna e' comunque segnalata rotta dall'autore di
jo_description, vedi jo_main.urdf.xacro riga "ODOMETRY SEEMS TO NOT WORK
FINE" — stesso commento presente anche in ~/jo_sim_giacomo).
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="jo">

  <xacro:include filename="$(find jo_description)/urdf/robot_core.xacro" />
  <xacro:include filename="$(find jo_description)/urdf/track.xacro" />
  <xacro:track side="left"/>
  <xacro:track side="right"/>

  <xacro:include filename="$(find jo_description)/urdf/imu.xacro" />
  <xacro:include filename="$(find jo_description)/urdf/front_depth.xacro" />
  <xacro:include filename="$(find jo_description)/urdf/back_depth.xacro" />

  <!-- vedi commento in testa al file: sostituisce urdf/velodyne.xacro di jo_description -->
  <xacro:include filename="$(find pacer_sim)/urdf/lidar_standard.xacro" />

  <!-- Ruote virtuali per la propulsione — vedi nota in testa al file.
       inertial_cylinder viene da inertial_macros.xacro, incluso da
       robot_core.xacro sopra (le macro xacro sono globali una volta
       definite, indipendentemente da quale file le include). -->
  <xacro:property name="wheel_radius" value="0.2" />
  <xacro:property name="wheel_width" value="0.08" />
  <xacro:property name="wheel_mass" value="2.0" />
  <xacro:property name="wheel_x" value="0.3" />
  <xacro:property name="wheel_y" value="${chassis_width/2 + wheel_width/2 + 0.02}" />
  <!-- Il fondo dei cingoli reali (rulli raggio back_roller_radius=0.09 a
       z=-chassis_height=-0.273 rispetto a base_link, vedi track.xacro)
       arriva a circa -0.36/-0.4. Le ruote vanno posizionate piu' in basso
       di cosi', altrimenti i cingoli toccano terra per primi — e siccome
       track.xacro carica comunque TrackController per ogni link (anche
       senza il plugin TrackedVehicle, tolto qui), la loro collision
       "customizzata" a velocita' zero blocca l'intero corpo rigido come
       un freno a mano, vanificando le ruote. -0.3 (fondo ruota a -0.5)
       da margine di sicurezza. -->
  <xacro:property name="wheel_z" value="-0.3" />

  <xacro:macro name="drive_wheel" params="side y_sign">
    <link name="${side}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <xacro:inertial_cylinder mass="${wheel_mass}" radius="${wheel_radius}" length="${wheel_width}">
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      </xacro:inertial_cylinder>
    </link>

    <joint name="base2${side}_wheel" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_wheel"/>
      <origin xyz="0 ${y_sign * wheel_y} ${wheel_z}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>

    <gazebo reference="${side}_wheel">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:drive_wheel side="left" y_sign="1"/>
  <xacro:drive_wheel side="right" y_sign="-1"/>

  <!-- Supporti passivi (caster via sfera a bassissimo attrito) davanti e
       dietro, solo per non far ribaltare lo chassis lungo 0.94m — non
       motorizzati, giunto fixed, attrito quasi nullo cosi' non resistono
       al movimento delle ruote motrici. -->
  <xacro:property name="caster_radius" value="${wheel_radius}" />
  <xacro:macro name="caster" params="side x_sign">
    <link name="${side}_caster">
      <visual>
        <geometry><sphere radius="${caster_radius}"/></geometry>
        <material name="black"/>
      </visual>
      <collision>
        <geometry><sphere radius="${caster_radius}"/></geometry>
      </collision>
      <xacro:inertial_sphere mass="0.3" radius="${caster_radius}">
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </xacro:inertial_sphere>
    </link>
    <joint name="base2${side}_caster" type="fixed">
      <parent link="base_link"/>
      <child link="${side}_caster"/>
      <origin xyz="${x_sign * (wheel_x + 0.1)} 0 ${wheel_z}" rpy="0 0 0"/>
    </joint>
    <gazebo reference="${side}_caster">
      <mu1>0.02</mu1>
      <mu2>0.02</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:caster side="front" x_sign="1"/>
  <xacro:caster side="back" x_sign="-1"/>

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
      <left_joint>base2left_wheel</left_joint>
      <right_joint>base2right_wheel</right_joint>
      <wheel_separation>${2 * wheel_y}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <!-- Il robot andava solo dritto: avevo impostato solo i limiti di
           ACCELERAZIONE, mai quelli di VELOCITA' — senza
           max/min_angular_velocity espliciti il default sembra azzerare
           di fatto la velocita' angolare consentita. -->
      <max_linear_velocity>2.0</max_linear_velocity>
      <min_linear_velocity>-2.0</min_linear_velocity>
      <max_angular_velocity>1.5</max_angular_velocity>
      <min_angular_velocity>-1.5</min_angular_velocity>
      <max_linear_acceleration>5.0</max_linear_acceleration>
      <min_linear_acceleration>-5.0</min_linear_acceleration>
      <max_angular_acceleration>2.5</max_angular_acceleration>
      <min_angular_acceleration>-2.5</min_angular_acceleration>
      <topic>cmd_vel</topic>
      <!-- niente odom/tf da qui: pubblicati dall'OdometryPublisher sotto -->
    </plugin>
  </gazebo>

  <!-- Odometria/TF "pulite" dalla posa reale del modello — vedi nota in
       testa al file. -->
  <gazebo>
    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_topic>odom</odom_topic>
      <odom_publish_frequency>50</odom_publish_frequency>
      <tf_topic>tf</tf_topic>
    </plugin>
  </gazebo>

</robot>
